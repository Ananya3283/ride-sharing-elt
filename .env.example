# Copy to .env (gitignored). Local-only credentials for the Docker stack.
POSTGRES_USER=elt
POSTGRES_PASSWORD=elt_local_pw
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=lake_local_pw
AIRFLOW_JWT_SECRET=change-me-to-any-long-random-string

# Pipeline settings
LAKE_BUCKET=ride-lake
# Fraction of each month's ~20M trips to keep (1.0 = everything). 0.05 keeps ~1M rows.
SAMPLE_FRACTION=0.05
